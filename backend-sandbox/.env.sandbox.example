# =====================================================================
# .env.sandbox.example — copy to .env.sandbox and fill in
#
# This file is a TEMPLATE. The actual .env.sandbox is gitignored.
#
# Sandbox env is INDEPENDENT of production backend/.env. Specifically:
#  - JWT_SECRET here is DIFFERENT from production. Tokens not interchangeable.
#  - ANTHROPIC_API_KEY can be the same OR a separate billing-tagged key.
#  - No SAP_*, no LOGISTICS_SQL_*, no SMTP_* — sandbox doesn't need them.
# =====================================================================

# Bind port. Sandbox listens on 127.0.0.1 only — never 0.0.0.0.
SANDBOX_PORT=4101

# JWT secret for sandbox-issued tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# DO NOT reuse production JWT_SECRET — that would let sandbox tokens
# authenticate against production routes (and vice versa).
SANDBOX_JWT_SECRET=replace-me-with-64-chars-of-random

# Optional bearer token to gate sandbox HTTP endpoints. If empty,
# sandbox is open on localhost (single-operator host assumption).
# If set, every /sandbox/* call must send Authorization: Bearer <this>
SANDBOX_ACCESS_TOKEN=

# Anthropic API key. If you want a separate billing tag for sandbox
# usage, create a sub-key in the Anthropic console.
ANTHROPIC_API_KEY=

# Anthropic model. Sandbox should default to the cheapest model that
# can do the job; experiments don't need top-tier output.
ANTHROPIC_MODEL=claude-haiku-4-5

# Mock vs live mode.
#   true  = use cached JSON in mock-data/ (default; cheapest, safest)
#   false = read live SAP via mssql (requires SAP_SQL_* below + manual care)
SANDBOX_USE_MOCK=true

# Hard cost ceilings — enforced in agents/runtime.js
SANDBOX_DAILY_BUDGET_USD=5.00
SANDBOX_PER_RUN_BUDGET_USD=0.50

# Per-run safety limits
SANDBOX_MAX_TOOL_CALLS=8
SANDBOX_MAX_TOKENS_OUT=2000

# Optional: live SAP read (only used when SANDBOX_USE_MOCK=false).
# SAP_SQL_HOST=
# SAP_SQL_PORT=1433
# SAP_SQL_USER=
# SAP_SQL_PASSWORD=
# SAP_SQL_DB_A=
# SAP_SQL_DB_B=
# SAP_SQL_ENCRYPT=true
# SAP_SQL_TRUST_SERVER_CERT=true

# NEVER set these in sandbox env — they exist as a forbidden marker:
# SAP_WRITE_ENABLED=  ← if you find yourself wanting this, you're in the wrong env
# SAP_SERVICE_LAYER_URL=  ← same
