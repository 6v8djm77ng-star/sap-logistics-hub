node_modules/
*.log
.env
dist/
.DS_Store

# OSRM container data — large binary OSM extract + processed graphs.
# Regenerable from infra/osrm/docker-compose.yml + Geofabrik download.
infra/osrm/data/*
!infra/osrm/data/.gitkeep

# PDF rendering test artifacts (created by scripts that re-generate PDFs
# before/after a change and diff them visually). Disposable.
.pdftest-*.pdf

# Local Claude Code settings (per-clone, not shared).
frontend/.claude/
backend/.claude/

# AI sandbox local config (the only file in backend-sandbox/ that can hold
# secrets — never commit). The rest of backend-sandbox/ is committed normally.
backend-sandbox/.env.sandbox

# Generated customer-doc-policy xlsx. Built by scripts/build_customer_doc_policy.py
# from the operator's Temp folder, contains OIG+UNICO customer master data.
# Regenerable; not committed.
docs/customer-doc-policy/*.xlsx

# ── Phase-1 baseline additions ─────────────────────────────────────

# Real env files (every variant — NEVER commit)
.env.local
.env.production
.env.production-staging
.env.development
.env.development.local
.env.test
.env.test.local
.env.staging
.env.*.local
.env.*.production

