# ═════════════════════════════════════════════════════════════════════════════
# Intelligence Layer — Phase 1 additions (sap-logistics-hub backend)
# ═════════════════════════════════════════════════════════════════════════════
# Append these to backend/.env when ready. All flags default to FALSE.
#
# Phase 1 deployment with all defaults:
#   - Zero behavior change to existing PM2 process
#   - intelligenceEvents.js route NOT mounted in server.js
#   - All new agents inactive
#   - SAP / orders / picking / driver flows unchanged
#
# Note: backend/src/config/env.js is NOT modified by Phase 1.
# These flags are read directly from process.env by featureFlags.js.

# ── Master switches ──────────────────────────────────────────────────────────
ENABLE_EVENT_BUS=false
ENABLE_SOCIAL_INTELLIGENCE=false
ENABLE_HEBREW_CLASSIFIER=false
ENABLE_META_CONNECTORS=false
ENABLE_INTEL_ALERTS=false
ENABLE_EXECUTIVE_DIGEST=false

# ── Event bus configuration ──────────────────────────────────────────────────
EVENT_BUS_DRIVER=noop                # noop | http | redis-streams (future) | kafka (future)
INTEL_BUS_URL=                       # Where to POST when EVENT_BUS_DRIVER=http
INTEL_BUS_RECEIVER_TOKEN=            # Required to mount /api/intelligence/events; service-to-service auth

# ── Debug ────────────────────────────────────────────────────────────────────
INTEL_DEBUG_LOG_EVENTS=false

# ── AI cost protection (Phase 4+; tracked Phase 1, enforced Phase 4+) ────────
INTEL_AI_DAILY_TOKEN_BUDGET=1000000
INTEL_AI_HOURLY_USD_LIMIT=5.0
INTEL_AI_PRIMARY_MODEL=claude-sonnet-4-5
INTEL_AI_FALLBACK_MODEL=claude-haiku-4-5

# ── Alerts (Phase 7+) ────────────────────────────────────────────────────────
INTEL_ALERT_DEDUP_WINDOW_MIN=60
INTEL_ALERT_THROTTLE_PER_HOUR=20
INTEL_ALERT_COOLDOWN_MIN=30

# ── Schedulers (Phase 4+) ────────────────────────────────────────────────────
INTEL_AGENT_HOURLY_ENABLED=false
INTEL_DIGEST_RECIPIENTS=             # Comma-separated emails for daily intel digest
INTEL_DIGEST_CRON=0 7 * * *

# ── Retention (used by archive worker, Phase 4+) ─────────────────────────────
INTEL_EVENT_RETENTION_DAYS=90
INTEL_INSIGHT_RETENTION_DAYS=365
