# ========================================
# Server
# ========================================
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ========================================
# Authentication
# ========================================
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=8h
JWT_DRIVER_EXPIRES_IN=7d
JWT_AUDIENCE=sap-logistics-hub
JWT_ISSUER=sap-logistics-hub-api
# Set to true after all clients have re-issued tokens with aud/iss claims.
JWT_STRICT_VERIFY=false
# bcrypt cost factor for new password hashes. 12 ≈ ~250ms on modern CPUs.
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=8

# ========================================
# CORS (comma-separated origin allow-list)
# ========================================
# Must include EVERY public origin that loads the frontend. The demoServer
# now enforces this allow-list — origins not on the list are blocked at
# the CORS layer (no Access-Control-Allow-Origin header in the response).
# Include localhost for dev, your LAN IP for office, and the Cloudflare
# Tunnel hostname for the public URL. Comma-separated, no spaces.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4000,https://your-tunnel.trycloudflare.com

# ========================================
# SAP Business One - Service Layer (REST API - for writing)
# ========================================
SAP_SL_URL=https://your-sap-server:50000/b1s/v1
SAP_SL_USERNAME=manager
SAP_SL_PASSWORD=your-password
# OIG test environment companies:
SAP_SL_COMPANY_DB_A=SAP_OIG_TEST_290724
SAP_SL_COMPANY_DB_B=Test_Unico
SAP_SL_SSL_REJECT_UNAUTHORIZED=false

# ========================================
# SAP Business One - SQL Server (for reading, faster)
# ========================================
SAP_SQL_HOST=localhost
SAP_SQL_PORT=1433
SAP_SQL_USER=sa
SAP_SQL_PASSWORD=your-password
# Same DBs as above - SQL and Service Layer use identical DB names
SAP_SQL_DB_A=SAP_OIG_TEST_290724
SAP_SQL_DB_B=Test_Unico
SAP_SQL_ENCRYPT=true
SAP_SQL_TRUST_SERVER_CERT=true

# ========================================
# Logistics Database (our new DB)
# ========================================
LOGISTICS_SQL_HOST=localhost
LOGISTICS_SQL_PORT=1433
LOGISTICS_SQL_USER=sa
LOGISTICS_SQL_PASSWORD=your-password
LOGISTICS_SQL_DB=SAP_Logistics_Hub
# Connection encryption defaults. trustServerCertificate=true is a transitional
# compromise — flip to false once SQL Server has a CA-signed certificate.
LOGISTICS_SQL_ENCRYPT=true
LOGISTICS_SQL_TRUST_SERVER_CERT=true

# ========================================
# Business Rules
# ========================================
DISTRIBUTION_ZONES_COUNT=7
DEFAULT_DRIVERS_COUNT=2

# ========================================
# Email (SMTP) - for alerts, daily digest, proof of delivery
# ========================================
# Leave empty to disable emails (will log to DB only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SAP Logistics Hub <noreply@yourdomain.com>"

# ========================================
# SMS provider - for customer arrival notifications
# ========================================
# Options: none | twilio | inforu | 019
SMS_PROVIDER=none
SMS_FROM=OIG

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+972...

# ========================================
# Public portal - for customer tracking links sent via SMS
# ========================================
PORTAL_BASE_URL=http://localhost:5173
